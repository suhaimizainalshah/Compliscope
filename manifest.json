{
  "manifest_version": 3,
  "name": "AI Benar: Privacy, AI Law and Security Checker",
  "short_name": "AI Benar",
  "version": "1.2.0",
  "description": "Check websites for GDPR, EU AI Act and Asian and US AI and data laws, with plain fixes, an AI law atlas and a plan for non-profits.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/suhaimizainalshah/Compliscope",
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Benar",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "cookies",
    "browsingData",
    "contextMenus"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Open AI Benar"
    },
    "audit-site": {
      "suggested_key": {
        "default": "Alt+Shift+U"
      },
      "description": "Audit this site"
    }
  }
}